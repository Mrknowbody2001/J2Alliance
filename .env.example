# Copy these values into your local .env file. Never commit the real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
CUSTOMER_SESSION_SECRET="replace-with-a-different-long-random-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Set this only in Vercel. Leave it unset locally to use the request's localhost URL.
# GOOGLE_REDIRECT_URI="https://j2-alliance.vercel.app/api/customer/google/callback"
ADMIN_USERNAME="choose-a-unique-admin-name"
ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"

# Cloudinary account used by the upload routes.
# Use your Cloudinary product environment's cloud name.
# Get the API key and secret from Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Optional alternative for unsigned uploads. If you set this, API key/secret are
# not required, but the preset must be configured as unsigned in Cloudinary.
CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Admin email one-time code delivery (Gmail SMTP using a Google App Password)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-google-app-password
